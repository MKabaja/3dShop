{
    "compilerOptions": {
        "resolveJsonModule": true,
        "esModuleInterop": true,
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "jsx": "react-jsx",
        "skipLibCheck": true,
        "types": ["vite/client", "ziggy-js"],

        "paths": {
            "@/*": ["./resources/js/*"],
            "@features/*": ["./resources/js/features/*"],
            "@navigation/*": ["./resources/js/navigation/*"],
            "@shared/*": ["./resources/js/shared/*"],
            "@ui/*": ["./resources/js/shared/ui/*"],
            "@hooks/*": ["./resources/js/shared/hooks/*"],
            "@types/*": ["./resources/js/shared/types/*"],
            "@constants/*": ["./resources/js/shared/constants/*"],
            "@components/*": ["./resources/js/components/*"],
            "@layouts/*": ["./resources/js/layouts/*"],
            "@pages/*": ["./resources/js/pages/*"],
            "@locales/*": ["./resources/js/locales/*"]
        }
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.tsx",
        "resources/js/**/*.d.ts",
        "vite.config.ts"
    ]
}
